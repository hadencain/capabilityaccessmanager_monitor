{
  "name": "cammonitor",
  "version": "1.0.0",
  "description": "Windows tray app to monitor and remediate CapabilityAccessManager.db-wal runaway growth",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "create-icons": "node scripts/create-icons.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0",
    "jest": "^29.0.0",
    "pngjs": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/tests/__mocks__/electron.js"
    }
  },
  "build": {
    "appId": "com.cammonitor.app",
    "productName": "CAMmonitor",
    "win": {
      "target": "nsis",
      "icon": "assets/icon-green.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      { "from": "service/", "to": "service" },
      { "from": "assets/", "to": "assets" }
    ]
  }
}
